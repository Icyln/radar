# Next.js local environment.
# Copy this file to frontend/.env.local and do not commit .env.local.

# LOCAL DEVELOPMENT (recommended when uvicorn runs locally):
RADAR_API_URL=http://127.0.0.1:8000
RADAR_SESSION_MAX_AGE_SECONDS=3600

# To test the local UI against your deployed Render backend instead, replace
# RADAR_API_URL above with the Render service origin, for example:
# RADAR_API_URL=https://your-radar-api.onrender.com
# Both https://host and https://host/api/v1 are accepted.

# Normally leave NEXT_PUBLIC_API_URL unset. RADAR_API_URL is server-only and preferred.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

RADAR_BFF_MAX_REQUEST_BYTES=262144
RADAR_BFF_UPSTREAM_TIMEOUT_MS=20000
RADAR_BFF_WIDE_SEARCH_TIMEOUT_MS=60000
