# Next.js local environment.
# Copy this file to frontend/.env.local and do not commit .env.local.

# To test the local UI against your deployed Render/Supabase backend:
RADAR_API_URL=https://YOUR-RENDER-SERVICE.onrender.com
RADAR_SESSION_MAX_AGE_SECONDS=3600

# Normally leave NEXT_PUBLIC_API_URL unset. RADAR_API_URL is server-only and preferred.
# NEXT_PUBLIC_API_URL=http://localhost:8000
