# Shared / backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# Manual PostgreSQL (no Docker required)
DATABASE_URL=postgresql+psycopg://radar:CHANGE_ME@localhost:5432/radar

# Phase 3 authentication
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_MINUTES=60
# Comma-separated emails that should become admins when they register.
# Existing users can be promoted with: python -m app.scripts.set_admin --email you@example.com
ADMIN_EMAILS=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Monitoring
JOB_MISSING_THRESHOLD=3
MONITOR_HTTP_CONNECT_TIMEOUT_SECONDS=5
MONITOR_HTTP_READ_TIMEOUT_SECONDS=15
MONITOR_HTTP_MAX_RETRIES=2
MONITOR_USER_AGENT=RadarJobMonitor/0.6 (+personal job monitoring)
MONITOR_MAX_CONCURRENCY=3
# Normally set automatically by GitHub Actions; useful for local diagnostics only.
MONITOR_RUN_TRIGGER=
MONITOR_EXTERNAL_RUN_ID=


# Phase 6 targeted source discovery
DISCOVERY_USER_AGENT=RadarDiscovery/0.7 (+profile-driven ATS source discovery)
DISCOVERY_MAX_PAGES_PER_TARGET=6
DISCOVERY_TARGET_BATCH_SIZE=25
DISCOVERY_CANDIDATE_BATCH_SIZE=50
DISCOVERY_MAX_CONCURRENCY=3
DISCOVERY_STALE_MINUTES=30
DISCOVERY_TARGET_TOTAL_TIMEOUT_SECONDS=30
DISCOVERY_CANDIDATE_TOTAL_TIMEOUT_SECONDS=30

# Telegram
# TELEGRAM_BOT_TOKEN: create a bot with Telegram @BotFather and /newbot.
# TELEGRAM_BOT_USERNAME: username without the leading @, e.g. my_radar_jobs_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Recommended for Phase 3 webhook verification. Generate with the same secrets command above.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TOKEN_MINUTES=10
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
TELEGRAM_MAX_ATTEMPTS=3
TELEGRAM_SENDING_STALE_MINUTES=10

# Phase 1 single-recipient smoke-test compatibility.
# Phase 2+ normal notifications use each verified user's telegram_connections row.
PHASE1_TELEGRAM_CHAT_ID=
PHASE1_NOTIFY_TITLE_KEYWORDS=
PHASE1_NOTIFY_ALL_NEW_JOBS=false
PHASE1_NOTIFY_ON_INITIAL_SYNC=false
PHASE1_MAX_NOTIFICATIONS_PER_RUN=10

# Frontend / Next.js BFF
# Prefer RADAR_API_URL because it remains server-side. NEXT_PUBLIC_API_URL is a compatibility fallback.
RADAR_API_URL=http://localhost:8000
RADAR_SESSION_MAX_AGE_SECONDS=3600
NEXT_PUBLIC_API_URL=http://localhost:8000

# Phase 6B automatic registry growth
# Optional comma-separated public CSV/JSON feed URLs. These are not secrets.
DISCOVERY_SYSTEM_FEED_URLS=
DISCOVERY_SYSTEM_FEED_MAX_BYTES=1000000
DISCOVERY_SYSTEM_TARGET_REFRESH_DAYS=30
DISCOVERY_REVALIDATE_DAYS=14
DISCOVERY_REVALIDATE_BATCH_SIZE=50
DISCOVERY_INVALID_RETRY_DAYS=7
DISCOVERY_SYSTEM_FEED_MAX_ENTRIES=1000

# Phase 7: profile-driven active-hiring discovery (no user CSV required)
DISCOVERY_HIRING_SIGNALS_ENABLED=true
DISCOVERY_HIRING_MAX_AGE_DAYS=30
DISCOVERY_HIRING_MAX_QUERIES=25
DISCOVERY_HIRING_MAX_SIGNALS_PER_RUN=500
DISCOVERY_HIRING_MAX_IDENTIFIER_GUESSES=3
DISCOVERY_HIRING_MAX_PROBE_CANDIDATES_PER_RUN=150
DISCOVERY_HIRING_REQUEST_TOTAL_TIMEOUT_SECONDS=25
DISCOVERY_HIRING_ARBEITNOW_ENABLED=true
DISCOVERY_HIRING_ARBEITNOW_PAGES=2
DISCOVERY_HIRING_HIMALAYAS_ENABLED=true
DISCOVERY_HIRING_PRIORITY_BOOST_DAYS=7
