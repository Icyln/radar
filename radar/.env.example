MONITOR_HTTP_READ_TIMEOUT_SECONDS=15
MONITOR_HTTP_MAX_RETRIES=2
MONITOR_USER_AGENT=RadarJobMonitor/0.3 (+personal job monitoring)

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_TOKEN_MINUTES=10
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
TELEGRAM_MAX_ATTEMPTS=3
TELEGRAM_SENDING_STALE_MINUTES=10

PHASE1_TELEGRAM_CHAT_ID=
