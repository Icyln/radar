# Radar 0.8.0 — shared/backend configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://radar:CHANGE_ME@localhost:5432/radar

# Production database pool (conservative defaults for Render + Supabase)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_MINUTES=60
ADMIN_EMAILS=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# User/product limits
MAX_JOB_PROFILES_TOTAL=10
MAX_ACTIVE_JOB_PROFILES=5
MAX_JOB_TITLES_PER_PROFILE=5
MAX_ACTIVE_JOB_TITLES_PER_USER=25

# API safety / rate limits
API_MAX_REQUEST_BYTES=524288
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600
WIDE_REFRESH_RATE_LIMIT=3
WIDE_REFRESH_RATE_WINDOW_SECONDS=300
DISCOVERY_REQUEST_RATE_LIMIT=10
DISCOVERY_REQUEST_RATE_WINDOW_SECONDS=3600
TELEGRAM_TEST_RATE_LIMIT=5
TELEGRAM_TEST_RATE_WINDOW_SECONDS=300

# Direct company monitoring
JOB_MISSING_THRESHOLD=3
MONITOR_HTTP_CONNECT_TIMEOUT_SECONDS=5
MONITOR_HTTP_READ_TIMEOUT_SECONDS=15
MONITOR_HTTP_MAX_RETRIES=2
MONITOR_USER_AGENT=RadarJobMonitor/0.8.0 (+personal job monitoring)
MONITOR_MAX_CONCURRENCY=3
MONITOR_RUN_TRIGGER=
MONITOR_EXTERNAL_RUN_ID=
MONITOR_HEALTH_STALE_MINUTES=90

# Broad job/source discovery
DISCOVERY_USER_AGENT=RadarDiscovery/0.8.0 (+wide job discovery and ATS source resolution)
DISCOVERY_MAX_PAGES_PER_TARGET=6
DISCOVERY_HTML_MAX_BYTES=2000000
DISCOVERY_TARGET_BATCH_SIZE=25
DISCOVERY_CANDIDATE_BATCH_SIZE=50
DISCOVERY_MAX_CONCURRENCY=3
DISCOVERY_STALE_MINUTES=30
DISCOVERY_TARGET_TOTAL_TIMEOUT_SECONDS=30
DISCOVERY_CANDIDATE_TOTAL_TIMEOUT_SECONDS=30
DISCOVERY_SYSTEM_FEED_URLS=
DISCOVERY_SYSTEM_FEED_MAX_BYTES=1000000
DISCOVERY_SYSTEM_FEED_MAX_ENTRIES=1000
DISCOVERY_SYSTEM_TARGET_REFRESH_DAYS=30
DISCOVERY_REVALIDATE_DAYS=14
DISCOVERY_REVALIDATE_BATCH_SIZE=50
DISCOVERY_INVALID_RETRY_DAYS=7
DISCOVERY_HIRING_SIGNALS_ENABLED=true
DISCOVERY_HIRING_MAX_AGE_DAYS=30
DISCOVERY_HIRING_MAX_QUERIES=25
DISCOVERY_HIRING_MAX_SIGNALS_PER_RUN=1000
DISCOVERY_HIRING_MAX_IDENTIFIER_GUESSES=3
DISCOVERY_HIRING_MAX_PROBE_CANDIDATES_PER_RUN=150
DISCOVERY_HIRING_REQUEST_TOTAL_TIMEOUT_SECONDS=25
DISCOVERY_HIRING_ARBEITNOW_ENABLED=true
DISCOVERY_HIRING_ARBEITNOW_PAGES=4
DISCOVERY_HIRING_HIMALAYAS_ENABLED=true
DISCOVERY_HIRING_HIMALAYAS_PAGES=3
DISCOVERY_HIRING_PRIORITY_BOOST_DAYS=7
DISCOVERY_WIDE_DEDUP_WINDOW_DAYS=45
DISCOVERY_WIDE_UNKNOWN_AFTER_DAYS=14
DISCOVERY_WIDE_CLOSE_AFTER_DAYS=45
DISCOVERY_RUN_TRIGGER=
DISCOVERY_EXTERNAL_RUN_ID=
DISCOVERY_HEALTH_STALE_MINUTES=480

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_REQUIRE_WEBHOOK_SECRET_IN_PRODUCTION=true
TELEGRAM_LINK_TOKEN_MINUTES=10
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
TELEGRAM_MAX_ATTEMPTS=3
TELEGRAM_SENDING_STALE_MINUTES=10
TELEGRAM_MAX_NOTIFICATIONS_PER_RUN=100

# Next.js BFF
RADAR_API_URL=http://localhost:8000
RADAR_SESSION_MAX_AGE_SECONDS=3600
RADAR_BFF_MAX_REQUEST_BYTES=262144
RADAR_BFF_UPSTREAM_TIMEOUT_MS=20000
RADAR_BFF_WIDE_SEARCH_TIMEOUT_MS=60000
